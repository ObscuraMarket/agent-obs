# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Secrets and local env. Never commit real keys. Templates (.env.example) stay.
.env
.env.*
!.env.example

# Runtime state: OBS's journals, the X ledgers, cursors, locks. They belong to
# the agent's memory repo (scripts/_obs-backup.sh), not to source control.
agent/data/
*.jsonl
*.log

# launchd jobs are generated per machine by scripts/install-launchd.sh, which
# fills in absolute paths. Committing them would leak local paths.
agent/scripts/launchd/*.plist
!agent/scripts/launchd/*.plist.template

# Key material must never enter the repo. The wallet lives in ~/.obs/wallet by
# design; these patterns are a second line of defence.
*.wallet.json
*.keypair.json
*.pem
*.key

# Editor and OS cruft
.DS_Store
.claude/settings.local.json
*.code-workspace
data-railway/
