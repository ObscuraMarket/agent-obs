{
  "name": "agent-obs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OBS, Obscura's own agent. Built on OpenHermit. Private liquidity, tokenized-stock cashback, one voice at @ObscuraCEX.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "post": "tsx src/autopilot.ts",
    "post:dry": "DRY_RUN=1 tsx src/autopilot.ts",
    "engage": "tsx src/engage.ts",
    "engage:dry": "DRY_RUN=1 tsx src/engage.ts",
    "reads": "tsx src/obscura/reads.ts",
    "setup": "node scripts/ohsetup.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dashboard": "tsx src/server.ts",
    "desk": "tsx src/desk/cycle.ts",
    "desk:dry": "DRY_RUN=1 tsx src/desk/cycle.ts"
  },
  "dependencies": {
    "@openhermit/sdk": "^0.7.0",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
