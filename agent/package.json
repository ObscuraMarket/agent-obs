{
  "name": "agent-obs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OBS, Obscura's own agent. Built on OpenHermit. Private liquidity, tokenized-stock cashback, one voice at @ObscuraCEX.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "obs": "tsx src/cli.ts",
    "post": "tsx src/autopilot.ts",
    "post:dry": "DRY_RUN=1 tsx src/autopilot.ts",
    "engage": "tsx src/engage.ts",
    "engage:dry": "DRY_RUN=1 tsx src/engage.ts",
    "reads": "tsx src/obscura/reads.ts",
    "pools": "tsx src/obscura/pools.ts",
    "setup": "node scripts/ohsetup.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dashboard": "tsx src/server.ts",
    "desk": "tsx src/desk/cycle.ts",
    "desk:dry": "DRY_RUN=1 tsx src/desk/cycle.ts",
    "model:check": "tsx scripts/modelCheck.ts",
    "x:check": "tsx scripts/xCheck.ts",
    "x:rehearse": "tsx scripts/xRehearse.ts",
    "x:post": "tsx scripts/xPost.ts",
    "unwrap": "tsx scripts/unwrap.ts",
    "key:check": "tsx scripts/keyCheck.ts",
    "aa:probe": "tsx scripts/aaProbe.ts",
    "usdg:sweep": "tsx scripts/usdgToEth.ts",
    "move:holdings": "tsx scripts/moveHoldings.ts",
    "own:probe": "tsx scripts/ownRouterProbe.ts",
    "console:walk": "tsx scripts/consoleWalk.ts",
    "live": "tsx src/desk/live.ts",
    "live:paper": "OBS_PAPER=on tsx src/desk/live.ts",
    "feedbuild": "tsx src/desk/feedbuild.ts",
    "wallet": "node scripts/wallet.mjs",
    "wallet:balances": "tsx src/obscura/walletBalances.ts",
    "capital": "tsx src/desk/capital.ts",
    "swap:probe": "tsx scripts/probeSwap.ts",
    "obscura:verify": "tsx scripts/verifyObscura.ts",
    "paper": "OBS_PAPER=on OBS_MIN_THOUGHT_GAP_MIN=0 tsx src/desk/cycle.ts",
    "paper:report": "tsx scripts/paperReport.ts",
    "paper:reset": "node -e \"for (const f of ['obs-paper.jsonl','obs-paper-book.jsonl']) { try { require('fs').unlinkSync(require('path').join(process.env.OBS_DATA_DIR || 'data', f)); console.log('removed', f) } catch {} }\"",
    "paper:trade": "tsx scripts/paperTrade.ts",
    "bridge:url": "node scripts/bridgeUrl.mjs",
    "paper:session": "bash scripts/_paper-session.sh",
    "relay": "bash ../scripts/relay-dashboard.sh",
    "replay:entries": "tsx scripts/replayEntries.ts",
    "replay:ignition": "tsx scripts/replayIgnition.ts",
    "book:withdraw": "tsx scripts/withdrawProposals.ts",
    "book:correct": "tsx scripts/correctTrade.ts"
  },
  "bin": {
    "obs": "bin/obs.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.18.1",
    "@openhermit/sdk": "^0.7.0",
    "twitter-api-v2": "^1.29.0",
    "viem": "^2.56.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
