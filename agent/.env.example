# OBS environment. Copy to .env and fill in. .env is gitignored.
# Documentation only: variable names, comments, placeholders. Never a real value.

# =============================================================================
# OpenHermit gateway. OBS's personas live here.
# =============================================================================
OPENHERMIT_GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_ADMIN_TOKEN=
# Or think without a gateway. The desk picks the gateway when it is set, else an
# Anthropic key, else any endpoint that speaks the OpenAI chat shape (OpenRouter,
# a local server). On these paths personality/obs/*.md is the system prompt. The
# X jobs still need the gateway; the desk does not.
ANTHROPIC_API_KEY=
# The model name: claude-opus-5 on the Anthropic path when blank, required on the
# OpenAI-shape path.
OBS_MODEL=
# The base URL, the one that ends in /v1, and its key when it needs one.
OBS_MODEL_URL=
OBS_MODEL_KEY=
# Gateway user id that owns the provisioned agents. Blank = the token's own user.
OBS_OWNER_USER_ID=
# Gateway agent ids. scripts/ohsetup.mjs provisions both from personality/.
# The operator persona thinks about the operation; the copywriter owns the
# timeline. The X jobs speak through the copywriter, never the operator.
OBS_AGENT_ID=obs
OBS_X_AGENT_ID=obs-copywriter

# =============================================================================
# The X account: Agent OBS's own, the trading desk speaking for itself
# =============================================================================
# OAuth 1.0a user-context credentials of the account (a developer app under it, Read and Write). X_LIVE must be
# exactly "true" for anything to post; anything else drafts to the ledger, which the Agent page shows.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_LIVE=false
X_HANDLE=
# Whose voice: trader is Agent OBS about its own trading from its own ledgers (personality/xtrader);
# copywriter is Obscura's company voice (personality/copywriter, OBS_X_VOICE.md).
OBS_X_VOICE=trader
# The live loop runs the posting job this often once the keys are set; the job keeps the post gap below and decides
# whether to speak. The engagement pass (replies to mentions, needs an API tier that reads mentions) only when on.
OBS_X_EVERY_MIN=20
OBS_X_ENGAGE=off
OBS_X_ENGAGE_EVERY_MIN=15
# 280 unless the account is Premium.
X_MAX_TWEET_CHARS=280
# Cadence floor between posts, checked before any model call.
OBS_MIN_POST_GAP_MIN=90
# Never reply more than this many times in one engage pass.
OBS_ENGAGE_CAP=3
# Word-overlap ceiling against recent posts (0..1).
OBS_SIMILARITY_MAX=0.45

# =============================================================================
# The desk (public thoughts, the book, PnL)
# =============================================================================
# Minutes between desk cycles, checked before any model call.
OBS_MIN_THOUGHT_GAP_MIN=25
# What a think costs. Every think opens its own gateway session (OBS_GATEWAY_SESSION=shared keeps one session that
# carries every past prompt, which is what made each think dearer over time). A fast tick that has an entry on the
# tape asks the rails first and does not think when they would refuse. An entry tick thinks through the fast
# persona (OBS_TICK_AGENT_ID, the desk's sibling on OBS_TICK_MODEL, created on the gateway by the desk); held
# reviews, exits and the 30-minute cycle keep the main persona. OBS_TICK_MODEL=off keeps every think on the main one.
# A held token's write-up comes every OBS_HELD_THINK_MIN minutes; its exits are checked far more often than that.
# Pick a tick model that writes without reasoning first: a reasoning model spends its budget thinking, writes nothing
# and overruns the gateway's 90 s. When the fast persona fails, the same prompt goes to the main persona once.
OBS_TICK_MODEL=google/gemini-2.5-flash
OBS_TICK_AGENT_ID=obs-fast
OBS_HELD_THINK_MIN=15
# Pairs the desk quotes each cycle, read-only: code/network->code/network:amount.
# Codes and networks are Obscura's (GET /currencies); Robinhood Chain is
# network "robinhood" with codes eth, usdg, nvda.
OBS_QUOTE_WATCHLIST="eth/robinhood->usdg/robinhood:0.05,usdg/robinhood->eth/robinhood:100"
# THE ARMING SWITCH. Off: a swap decision is a proposal on the board. On (and
# only with the wallet key present): a decision that passes every rail below
# is executed through Obscura from the desk's own wallet. Turn it on after the
# wallet is funded, the deposit is recorded, and you have read a few cycles.
OBS_TRADING=off
# The desk's alarm (alerts.ts): the live watch quiet past OBS_ALERT_STALE_MIN while trading is on, a cycle that
# failed (the model could not think, a crash), or an exit the chain refused, the desk's or an agent's. Each goes to
# the obs-alerts ledger, the log, /api/obs/health, and to this webhook when set: a Discord or Slack webhook URL, or
# an ntfy topic (https://ntfy.sh/<topic>, the phone app subscribes to it). One alert of a kind per cooldown.
OBS_ALERT_WEBHOOK=
OBS_ALERT_STALE_MIN=10
OBS_ALERT_COOLDOWN_MIN=30
# Rails. Dollars per swap, open orders at once, ETH kept back for gas on the
# from-chain, partners (blank = any Obscura quotes), and the SYMBOL@network
# pairs the desk may hold and move. Nothing is counted by the day: the desk
# enters whenever the reads say so, spaced (below) and under the loss brake.
OBS_MAX_SWAP_USD=25
OBS_MAX_OPEN_ORDERS=1
OBS_GAS_RESERVE_ETH=0.002
OBS_ALLOWED_PARTNERS=
OBS_TRADE_ASSETS=ETH@robinhood,USDG@robinhood
# Chains both legs of a swap must be on. The mandate is Robinhood Chain only.
OBS_TRADE_CHAINS=robinhood
# Where a decided swap runs once armed: the USDG pools on Robinhood Chain from
# the desk's own wallet (pool, the default), or Obscura's routes (obscura).
OBS_VENUE=pool
# The pool lane's slippage allowance below its own estimate, in percent.
OBS_SLIPPAGE_PCT=1

# ---- Launch candidates: the tokens a launch watcher finds, traded in the pool lane. ----
# The watcher's feed, a JSONL the operator runs elsewhere: rows of kind
# "candidate" (pool id, token, symbol, fee tier, gate verdict, hour, volume,
# move, senders) and "hourly" (per-pool volume and price). Empty = off.
OBS_CANDIDATE_FEED=
OBS_CANDIDATES=on
# A candidate must be this recent, at a tier at most this high, and gated by the watcher.
OBS_CANDIDATE_MAX_AGE_H=6
# A token younger than this since its launch is not a candidate at all (hours; 0 admits every age). The
# 2026-09-05 replays showed every first-hour entry losing; the desk went to 24, tokens with a day behind them.
OBS_CANDIDATE_MIN_AGE_H=0
# on: only a token whose hourly trail reads stable (the stability read) is graded; the rest is "no trading record yet".
OBS_CANDIDATE_REQUIRE_STABLE=off
# The survivors: the watcher's feed stops following a token at its 24th hour, so a poller (screenerpull.ts) asks a
# public screener about tokens the feed followed to a late hour, keeps the ones still trading by this record rule,
# resolves their pool keys on chain and writes data/obs-screener.json; the desk reads it as a second feed, and a
# token on it that passes is a grade B swing candidate with a trading record. The age floor above applies to it too.
OBS_SCREENER_EVERY_SEC=600
OBS_SCREENER_MIN_FEED_HOUR=18
OBS_SCREENER_MAX_TOKENS=300
OBS_SCREENER_MIN_VOL24_USD=250000
OBS_SCREENER_MIN_VOL1H_USD=10000
OBS_SCREENER_MIN_TXNS24=1000
OBS_SCREENER_MIN_LIQ_USD=50000
OBS_SCREENER_MIN_SIX_HOUR_SHARE=0.1
# A launchpad token at or above this market cap is on watch whatever its record (2026-09-06, user: "monitor all tokens
# above 1M market cap deployed on PONS"); it is graded for a buy only while its last hour clears OBS_SCREENER_MIN_VOL1H_USD.
OBS_SCREENER_MIN_CAP_USD=1000000
# A token above this market cap is not bought: a clip of the desk's size moves nothing there and a 15% target is a
# week's work. Zero: no ceiling. (2026-09-06, user: "why are we buying a 200m market cap coin with $100".)
OBS_SCREENER_MAX_CAP_USD=50000000
# A token below this market cap is not bought either: under it a pool is too thin to leave. Zero: no floor. The
# small-cap hunt of 2026-09-06 (user: "sub 100k entries looking for a 3-5x") runs 20000 to 100000 with the record
# scaled down: vol24 20000, vol1h 1000, txns24 200, liquidity 8000.
OBS_SCREENER_ENTRY_CAP_MIN_USD=0
# The desk's own launch feed, straight from the launchpad's contract (launchpull.ts): TokenLaunched events every
# OBS_LAUNCH_PULL_SEC seconds, each written as a feed row beside the watcher's file, so a launch is on the live watch
# within seconds of its block (the watcher logs one a median 109 s after, a quarter of them past six minutes).
# Defaults to launch-chain.jsonl next to OBS_CANDIDATE_FEED.
#OBS_CHAIN_FEED=data/feed/launch-chain.jsonl
OBS_LAUNCH_PULL_SEC=3
# Ignition, judged by the desk from the curve pool's first minutes: this many swaps from this many distinct wallets,
# and this many dollars where the pair can be priced (waived otherwise), inside the window after launch. The same bar
# the launch watcher uses, so the desk needs no watcher anywhere to take an ignited launch onto the live watch.
OBS_IGNITION_WINDOW_SEC=600
OBS_IGNITION_SWAPS=60
OBS_IGNITION_SENDERS=20
OBS_IGNITION_USD=10000
# The backfill: pool creations under the launchpad's hook over this many days, scanned backwards once in the
# background into pools-backfill.jsonl beside the feed, so the screener learns of every token that ever got a first
# buy, not only the last three days' launches. Zero skips it.
OBS_LAUNCH_BACKFILL_DAYS=7
# The screener's known set is screened as a hot set (keepers, and anything launched in the last OBS_SCREENER_HOT_HOURS)
# every round, plus a rotating slice of the cold set under OBS_SCREENER_MAX_CALLS batch calls a round (thirty tokens a
# call), so the whole set comes around every couple of hours.
OBS_SCREENER_MAX_CALLS=120
OBS_SCREENER_HOT_HOURS=48
OBS_CANDIDATE_MAX_TIER_PCT=5
OBS_CANDIDATE_REQUIRE_GATE=on
# Early launches: shown from minute one for this long; a probe is allowed only once the watcher called ignition and a hookless side pool exists.
OBS_EARLY_MAX_AGE_MIN=90
OBS_EARLY_REQUIRE_IGNITION=on
# A launch curve's hook charges its own fee the pool key does not show; this is what the desk assumes for its estimate, plus the creator tax. Curves get a wider slippage floor.
OBS_CURVE_FEE_PCT=2
OBS_CURVE_SLIPPAGE_PCT=8
# The probe rule: the first buy of any launch token is capped here until its sell is proven.
OBS_PROBE_USD=5
# Launch positions held at once, and the exits the rails enforce on their own.
OBS_MAX_CANDIDATES=1
OBS_CANDIDATE_MAX_HOLD_H=8
OBS_CANDIDATE_FLOOR_PCT=40
OBS_CANDIDATE_VOLUME_DROP_PCT=30
# The trader's exits on a launch token: take this share off once up this much, and once up at least the arm level,
# sell everything when the price gives back this much from its peak since entry.
OBS_CANDIDATE_TAKE_PROFIT_PCT=60
OBS_CANDIDATE_TAKE_PROFIT_SHARE=0.5
OBS_CANDIDATE_TRAIL_ARM_PCT=30
OBS_CANDIDATE_TRAIL_PCT=25
# The fast tick's own floor between model calls, in minutes (the tick timer runs every 5).
OBS_TICK_MIN_GAP_MIN=4
# The whole-book brake: past either drawdown limit from the day's opening mark, no new entries until the next UTC day. Exits still run.
OBS_DAILY_LOSS_USD=50
OBS_DAILY_LOSS_PCT=5
# Selectivity. Entries (not exits) are spaced, and a swap must be argued for:
# a thesis, this many EVIDENCE lines each quoting an observed figure, an invalidation, and this conviction (1 to 5).
OBS_MIN_HOURS_BETWEEN_ENTRIES=2
# Your apps in the console (Composio). Set the key and a signed-in wallet can connect Slack, Linear, X, Gmail,
# Google Docs and more to its own agent with /apps; the agent gets their tools and asks in the console before it
# does anything inside an app. Blank keeps apps off. OBS_APPS_TOOLKITS narrows the list (Composio toolkit slugs);
# OBS_APPS_CALLBACK_URL is where an app's sign-in returns the person (the console).
COMPOSIO_API_KEY=
# Models and credits. A person's agent runs on any model OpenRouter serves (/model); each turn costs from their
# credits at the model's price plus the margin, estimated from the text in and out (the gateway counts no tokens).
# A credit is a cent: a thousand credits are $10 of USDG. OBS_CREDITS_FREE is the welcome grant, in credits.
# Credits are bought by sending ETH, USDG, AOBS or a tokenized stock to the treasury: the operator's address, never
# the desk's trading wallet. Blank treasury: turns are metered but never refused.
OBS_USER_MODEL_ID=google/gemini-2.5-flash
OBS_MODELS_FEATURED=anthropic/claude-opus-5,openai/gpt-6-astra,google/gemini-3.8-flash,deepseek/deepseek-v4-flash-0731,x-ai/grok-4.6,meta-llama/llama-4-maverick
OBS_CREDITS_TREASURY=
OBS_CREDITS_FREE=100
OBS_CREDITS_MARGIN_PCT=25
OBS_CREDITS_AOBS_BONUS_PCT=10
OBS_CREDITS_CONTEXT_TOKENS=8000
# A payment is counted once this many blocks confirm it (its own included) and only within this many hours of its
# block, priced at that block from the desk's own price samples; older, it is refused for good.
OBS_CREDITS_CONFIRMATIONS=3
OBS_CREDITS_MAX_AGE_H=24
# The console is for holders: a wallet gets its agent only while it holds this much OBS or this much AOBS (whole
# tokens, either one), read on chain at sign-in and again every ten minutes. OBS_CONSOLE_GATE=off opens it to all.
# The allowlist (wallet addresses, commas or spaces between them) is always let in, holdings or not;
# OBS_CONSOLE_GATE=allowlist makes the list the only way in, for the first users before the door opens to holders.
OBS_CONSOLE_GATE=on
OBS_CONSOLE_MIN_OBS=1000
OBS_CONSOLE_MIN_AOBS=1000
OBS_CONSOLE_ALLOWLIST=

# The operator's own test followers, kept off the public Agents board (their signing addresses, comma separated):
# they still trade and still read their own book signed in; their public book is a 404.
OBS_AGENTS_HIDDEN=
# After a scale-out has banked profit, the rest leaves at cost: sold whole once it is this far under its cost.
# The upside stays (the remainder still trails from its peak); the downside on a trade that paid is capped. 0 disables.
OBS_CANDIDATE_REMAINDER_FLOOR_PCT=5
# Agent wallets: each person's agent gets a wallet of its own, derived from this seed and their address (never
# stored), funded from their wallet with /fund and emptied back to it with /withdraw. The seed IS the custody of
# every agent wallet: at least 32 characters, kept only here, never logged; lose it and every agent wallet is lost.
OBS_AGENT_WALLET_SEED=
# A funding is recorded once this many blocks confirm it, its own included.
OBS_FUND_CONFIRMATIONS=2
# Live mirroring: an agent that is on and funded sends the desk's trades from its own wallet at its size, and sells
# the same share when the desk sells. off stops every agent's live trading at once; paper agents are unaffected.
OBS_FOLLOW_LIVE=on
# The most an agent may put into one entry (/size, /start <size>); blank means what the desk itself trades
# (OBS_MAX_SWAP_USD). The pools are the same pools, so raise it with their depth in mind. The floor is $10.
OBS_FOLLOW_MAX_USD=
# How many agents are mirrored at once after a desk trade; each signs from its own wallet, so they never collide.
OBS_FOLLOW_PARALLEL=4
OBS_APPS_TOOLKITS=slack,linear,twitter,gmail,googledocs,googlesheets,googlecalendar,notion,github
OBS_APPS_CALLBACK_URL=https://obscura.markets/console
OBS_MIN_EVIDENCE=3
OBS_MIN_CONVICTION=4
# The basis on the tokenized stock is a side trade, off by default. OBS_BASIS=on adds NVDA@robinhood to the
# allowlist, reads the outside references, and puts the basis in the observation and on the page.
OBS_BASIS=off
OBS_BASIS_MIN_EDGE_PCT=0.25
# The bar for launch tokens, and the size each grade may reach. The first buy is always the probe (grade C size);
# a proven token can then be scaled to its grade cap, as a continuation. Below the bar is not tradable.
OBS_GRADE_A_MIN_VOL_USD=250000
OBS_GRADE_A_MIN_SENDERS=40
OBS_GRADE_A_MAX_MOVE_PCT=30
OBS_GRADE_A_MAX_TIER_PCT=3
OBS_GRADE_A_MIN_DEPTH_USD=20000
OBS_GRADE_A_MAX_DRAWDOWN_PCT=25
OBS_GRADE_A_MAX_HOUR=3
OBS_GRADE_B_MIN_VOL_USD=100000
OBS_GRADE_B_MIN_SENDERS=20
OBS_GRADE_B_MAX_MOVE_PCT=50
OBS_GRADE_B_MAX_TIER_PCT=4
OBS_GRADE_B_MAX_DRAWDOWN_PCT=40
OBS_CANDIDATE_MAX_USD_A=75
OBS_CANDIDATE_MAX_USD_B=25
OBS_CANDIDATE_MAX_USD_C=5
# Base RPC, only used if ETH@base is ever allowlisted (public default).
BASE_RPC_URL=https://mainnet.base.org

# =============================================================================
# Chain reads (public, read-only; OBS holds no key)
# =============================================================================
# The public RPC sits behind a bot challenge that blocks non-browser clients
# after a burst, and Blockscout's proxy rate-limits. Reads degrade to "not
# read" when that happens; the desk never counts an unread balance as zero.
# BEFORE ARMING set this to a provider endpoint (Alchemy serves Robinhood
# Chain), or every Robinhood-leg send will be refused by the pre-flight rail.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The agent's own token, AOBS on Robinhood Chain: shown on the page's Market
# card, read from its pool and its transfers, and never traded by the desk. The
# wallet holds it, off the book: not in equity, not on the curve, not a position.
# The desk never sells, buys, or approves it, and the same goes for $OBS
# (OBS_CONTRACT). Refused where a token enters the board, in the rails on either
# leg, in the exit scan, and in the on-chain executor before signing.
# OBS_NEVER_TRADE adds more contracts the desk must never touch (comma-separated).
OBS_AGENT_TOKEN=0x47366e0f257ac009e82bd46fb74e2fb50826ce98
OBS_NEVER_TRADE=
# The one 40-hex address a post may contain: the $OBS token on Robinhood Chain.
# Anything else is blocked by the guards.
OBS_CONTRACT=0xfe242d1da8fd04f6a1f80b6d3d807b02e062ad4e
OBSCURA_SITE_URL=https://obscura.market
OBSCURA_API_URL=https://api.obscura.market

# =============================================================================
# The wallet (OBS's own; scripts/wallet.mjs create)
# =============================================================================
# The PUBLIC address only. The key lives in OBS_WALLET_DIR (default
# ~/.obs/wallet, owner-only permissions), never in this file, never in the
# repo, and nothing in the loops loads it until the execution stage exists.
OBS_WALLET_ADDRESS=
OBS_WALLET_DIR=
# Ethereum mainnet RPC for the wallet's mainnet balance (public default).
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# =============================================================================
# State and memory
# =============================================================================
# Where journals, ledgers and cursors are written. Default: ./data
OBS_DATA_DIR=
# The PRIVATE git checkout OBS snapshots his memory into (see OBS-MEMORY.md).
# Blank or missing = the backup step is skipped quietly.
# A clone of the private obscura-memory repo; the desk timer commits journals and ledgers there daily.
OBS_MEMORY_REPO_DIR=
# DRY_RUN=1 rehearses a job and writes nothing.
DRY_RUN=

# =============================================================================
# Dashboard API (read-only JSON for the Obscura dashboard integration)
# =============================================================================
OBS_DASHBOARD_PORT=4671
# Comma-separated origins allowed to read the API in a browser. * = any.
OBS_DASHBOARD_ORIGINS=*
# An entry may carry one wildcard host label, for preview deployments: https://*.vercel.app
# Manners for public exposure: requests a minute per client, open streams in total and per client.
OBS_DASHBOARD_RATE_PER_MIN=120
# The forwarded client address is trusted only from a loopback, private or shared-range peer (Railway's edge is
# 100.64.0.2); "any" trusts it from every peer, for an edge the list does not know. Otherwise requests are budgeted
# by the socket's peer, and a public edge would make every visitor one client (2026-09-08).
OBS_TRUSTED_PROXY=
OBS_DASHBOARD_MAX_STREAMS=100
OBS_DASHBOARD_MAX_STREAMS_PER_IP=4
# The public bridge (scripts/_obs-tunnel.sh). A named Cloudflare tunnel token from the site's own zone
# gives a stable hostname such as obs-api.obscura.market; empty = a quick tunnel with a random hostname.
OBS_TUNNEL_TOKEN=

# ---- Hosted runner (docker compose; see DEPLOY.md). Ignored on the Mac. ----
# The desk cadence in seconds; the cycle's own 25-minute floor still applies.
OBS_DESK_INTERVAL_SEC=1800
# The X voice in the same process: on | off. Draft-first until X_LIVE=true.
OBS_VOICE=off
OBS_POST_INTERVAL_SEC=7200
OBS_ENGAGE_INTERVAL_SEC=600
# The private memory repo, as an HTTPS URL that can push (a fine-grained
# token scoped to that one repo). Cloned on first boot; the ledgers are
# restored from it when the data volume is empty; pushed to after cycles.
OBS_MEMORY_REPO_URL=
# The identity the backup commits as inside the container.
OBS_GIT_NAME=obs
OBS_GIT_EMAIL=obs@users.noreply.github.com

# ---- Paper sessions: the desk at full size with nothing sent. ----
# OBS_PAPER=on runs every step but the send and records paper trades in
# obs-paper.jsonl; `npm run paper` runs one cycle that way, `npm run
# paper:report` marks the paper book against the real one, `npm run
# paper:reset` clears it. Ignored while execution is armed.
OBS_PAPER=off

# The server (DEPLOY.md, "The server, as plain services"). OBS_SERVER is the
# ssh target the launch feed mirrors to every minute; OBS_PUBLIC_HOSTNAME is
# the API's public name there. Both are written by scripts/server/sync-to-server.sh.
OBS_SERVER=
OBS_PUBLIC_HOSTNAME=

# =============================================================================
# The entry read: volume puts a token on watch, price action gives the entry
# (agent/src/desk/entry.ts). Defaults shown; leave blank to keep them.
# =============================================================================
# Minutes of tape the read looks at, and the volume pickup (last 10 min against the earlier tape).
OBS_ENTRY_WINDOW_MIN=30
OBS_ENTRY_PICKUP_RATIO=2
OBS_ENTRY_MIN_SWAPS=6
# A run of at least this, within this much of its peak, is a spike: never bought.
OBS_ENTRY_SPIKE_RUN_PCT=15
OBS_ENTRY_SPIKE_NEAR_PEAK_PCT=3
# A pullback this far off the peak (and no further) that turned up by this much is an entry.
OBS_ENTRY_PULLBACK_MIN_PCT=8
OBS_ENTRY_PULLBACK_MAX_PCT=35
OBS_ENTRY_BOUNCE_MIN_PCT=2
# A range this tight over this many minutes, with an older peak, is a base.
OBS_ENTRY_BASE_RANGE_PCT=6
OBS_ENTRY_BASE_MIN=10
# Buy pressure over the last 10 minutes needed for any entry.
OBS_ENTRY_MIN_BUY_PRESSURE_PCT=50
# off: a held pullback after a run is read and refused; the desk buys bases only (the replays showed pullback entries buying tops).
OBS_ENTRY_PULLBACK=on
# The first buy of a token still inside its launch window (OBS_EARLY_MAX_AGE_MIN). A fresh launch moves 50% between
# blocks: SHARD won 19% in a minute and FRANKLIN lost 48% in one on 2026-09-06, so the launch lane takes the small
# ticket while a token with a record takes OBS_PROBE_USD. Unset, both lanes take OBS_PROBE_USD.
#OBS_PROBE_LAUNCH_USD=25
# A held position is checked against its exits on every review (OBS_LIVE_HELD_EVERY_MIN) with no model call; the model
# writes a review of it this often, in minutes. A tape that breaks (giveback, thinning buyers, roll-over) thinks at once.
OBS_HELD_THINK_MIN=10
# off: three falling five-minute buckets no longer sell an unpaid trade. For a hunt for a multiple in a thin pool, where
# every hour has such a stretch; the floor, the scale-out and the trail still apply.
OBS_CANDIDATE_TAPE_ROLLOVER_EXIT=on
# How far under where the 30-minute window started the price may sit before that alone reads as a breakdown. Zero: any
# tick under it (the launch rule). A survivor with a day of trading drifts a few percent either way; the desk runs 5.
OBS_ENTRY_BREAKDOWN_PCT=0
# on: the reads decide the entry. A candidate that passed the entry read, the holder read and the launch read in the
# same cycle is bought at the rails' size when the model held anyway; the argument is built from the observation's own
# lines and the model's writing stays the public reasoning. (2026-09-06: the model kept vetoing candidates its reads passed.)
OBS_AUTO_ENTRY=off

# =============================================================================
# The stability hunt: tokens that have already shown it (agent/src/desk/stability.ts)
# =============================================================================
# on|off. Stable tokens lead the candidates at grade B for a swing.
OBS_STABLE=on
OBS_STABLE_MIN_ACTIVE_HOURS=6
OBS_STABLE_MIN_HOUR_USD=1000
OBS_STABLE_MAX_DRAWDOWN_PCT=50
OBS_STABLE_PEAK_HOURS=12
OBS_STABLE_MAX_RANGE_PCT=40
OBS_STABLE_MIN_RECENT_RATIO=0.5
OBS_STABLE_MIN_SENDERS=20
OBS_STABLE_MAX_AGE_H=2
# Megabytes of the feed's tail read each cycle; 24 gives trails a day long.
OBS_FEED_TAIL_MB=24
# The feed builder (feedbuild.ts), the desk's own source of hourly rows since 2026-09-08: the watcher that wrote
# them ran on the operator's machine and stopped on 2026-09-07. Every OBS_FEEDBUILD_EVERY_SEC it rebuilds its
# watched set (the tokens the desk has traded, the scout's ranked pools, the screener's keepers with a key), capped
# at OBS_FEEDBUILD_MAX_POOLS, reads their swaps and the tokens' transfers, and appends one hourly row per pool per
# CLOSED hour to OBS_CANDIDATE_FEED, plus one side-pool row the first time a hookless USDG pool is watched. A pool
# seen for the first time is read OBS_FEEDBUILD_HISTORY_H hours back, a few pools a round under a call budget, so a
# trail with six active hours exists soon after the pool joins. OBS_FEEDBUILD_YOUNG_H adds launches younger than
# this many hours; 0 (the default) leaves them out: with rows, a young pool can read stable and enter the board at
# grade B past the screener's market-cap floor and ceiling, which the user refused on 2026-09-06. The history reads
# are budgeted per round in RPC calls (OBS_FEEDBUILD_MAX_CALLS, about fifteen a pool for eight hours, so 60 is three
# pools a round and a hundred-odd pools in a couple of hours): the public RPC answered 429 to a burst of sixty calls
# on 2026-09-08, and the live watch reads its tapes from the same RPC every three seconds.
OBS_FEEDBUILD_EVERY_SEC=300
OBS_FEEDBUILD_MAX_POOLS=120
OBS_FEEDBUILD_HISTORY_H=8
OBS_FEEDBUILD_YOUNG_H=0
OBS_FEEDBUILD_MAX_CALLS=60

# =============================================================================
# The live watch: the desk in real time (agent/src/desk/live.ts, desk/watch.ts)
# =============================================================================
# The watch runs the desk's cycles on its triggers, and it reads a held token's exit rails (floor, trail, take-profit,
# time stop) at the tape's last price on every look, so a rail trips within seconds rather than at the next review.
# off makes the hosted runner (scripts/run.sh) run cycles on its own interval instead, the old way.
OBS_LIVE=on
# Milliseconds between looks; balances refresh every this many ms.
OBS_LIVE_POLL_MS=3000
OBS_LIVE_BALANCES_MS=60000
OBS_LIVE_MAX_WATCH=8
# A held token is reviewed this often; an entry fires once, then again this often while it lasts;
# the least minutes between two cycles for one token; the tape give-back that fires an exit.
OBS_LIVE_HELD_EVERY_MIN=5
# The tape window in minutes, for the live watch and for the cycle's own reads alike (the dip read looks this far
# back for the pump it buys under). One window, so the cycle never calls a breakdown on the tape the watch read as a dip.
OBS_LIVE_TAPE_MIN=180
OBS_LIVE_ENTRY_EVERY_MIN=15
OBS_LIVE_COOLDOWN_MIN=3
OBS_LIVE_GIVEBACK_PCT=25
# A held token whose rail (floor, trail, take-profit, time stop) still trips this many minutes after its last cycle
# fires the exit trigger again. The watch and the cycle price the rails from the same tape; a rail one of them
# dismissed once is not left to slide.
OBS_LIVE_RAIL_REFIRE_MIN=3

# =============================================================================
# The base, and fills
# =============================================================================
# eth (default): every sell comes back to ETH and parking in USDG is refused unless the basis is on.
OBS_BASE=eth
# A pool swap must receive at least this share of its quote, else the desk treats it as failed.
OBS_MIN_FILL_RATIO=0.97

# =============================================================================
# Retired on 2026-09-08: the launch feed between machines (DEPLOY.md). The
# watcher that served its file at /api/obs/feed-tail stopped on 2026-09-07,
# and the desk builds its own hourly rows now (feedbuild.ts, OBS_FEEDBUILD_*
# above). feedpull.ts and the route stay in the tree unused; the runner no
# longer starts the puller, so nothing reads these. Leave them empty.
# =============================================================================
#OBS_FEED_TOKEN=
#OBS_FEED_SOURCE=
#OBS_FEED_PULL_SEC=5
#OBS_FEED_PULL_TAIL_MB=24
# A hosted desk with no mount: the key file's JSON, handed in as a variable, written once at boot.
OBS_WALLET_JSON=

# =============================================================================
# Profit taking, on the data: once a trade is up TAPE_EXIT_MIN_PCT, the rails
# scale out TAPE_EXIT_SHARE the moment the tape shows the buyers thinning (buy
# pressure under TAPE_EXIT_PRESSURE_PCT, or 5-minute volume rolling over), and
# the live watch fires that review within seconds. A take-profit and a trailing
# stop sit behind it as backstops (code defaults: 60%/half, trail 30%/25%).
# =============================================================================
OBS_CANDIDATE_TAPE_EXIT_MIN_PCT=15
OBS_CANDIDATE_TAPE_EXIT_PRESSURE_PCT=45
OBS_CANDIDATE_TAPE_EXIT_SHARE=0.6
OBS_CANDIDATE_TAKE_PROFIT_PCT=40
OBS_CANDIDATE_TAKE_PROFIT_SHARE=0.5
OBS_CANDIDATE_TRAIL_ARM_PCT=20
OBS_CANDIDATE_TRAIL_PCT=20
OBS_LIVE_GIVEBACK_PCT=20
OBS_LIVE_THIN_PRESSURE_PCT=45

# =============================================================================
# The holders (agent/src/desk/holders.ts): who holds each token in play, read
# from the chain's Transfer events. A token fails the read, and is not bought,
# when it has too few wallets, one wallet or the top ten hold too much of
# circulating, the first buyers look bundled (sharing a block or identical
# sizes inside the first seconds), or too many of the top ten are fresh.
# =============================================================================
OBS_HOLDERS_MIN_WALLETS=30
OBS_HOLDERS_MAX_TOP1_PCT=25
OBS_HOLDERS_MAX_TOP10_PCT=60
OBS_HOLDERS_MAX_BUNDLE_PCT=50
OBS_HOLDERS_EARLY_SEC=30
OBS_HOLDERS_MAX_FRESH_TOP10=7
OBS_HOLDERS_FRESH_TX_COUNT=3
OBS_HOLDERS_FIRST_PULL_HOURS=6
# The launch read (src/desk/launch.ts): the launch transaction and the factory
# record of a pons v2 token. The dev buy as a share of supply, the wallets
# declared exempt from the opening tax (the declared bundle), the creator tax
# and whether its fees go to a third party, the token's links, the deployer's
# record over the window, the curve's first minute, and the phase (curve,
# swept, pool, rescued). A score with reasons, and a gate: LAUNCH FAIL is not
# bought. Thresholds after the open sniper terminal bodkin, measured on this
# chain on 2026-09-03.
OBS_LAUNCH_MAX_DEV_SHARE_PCT=8
OBS_LAUNCH_MAX_CREATOR_TAX_BPS=300
OBS_LAUNCH_MAX_EXEMPT=2
OBS_LAUNCH_REQUIRE_SOCIALS=on
OBS_LAUNCH_MIN_SCORE=60
# A token with this many hours of trading behind it is read on the hard rules only (no socials check, no score bar).
OBS_LAUNCH_RECORD_AGE_H=24
OBS_LAUNCH_SERIAL_PRIOR=5
OBS_LAUNCH_DEPLOYER_WINDOW_BLOCKS=400000

