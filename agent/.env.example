# OBS environment. Copy to .env and fill in. .env is gitignored.
# Documentation only: variable names, comments, placeholders. Never a real value.

# =============================================================================
# OpenHermit gateway. OBS's personas live here.
# =============================================================================
OPENHERMIT_GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_ADMIN_TOKEN=
# Gateway user id that owns the provisioned agents. Blank = the token's own user.
OBS_OWNER_USER_ID=
# Gateway agent ids. scripts/ohsetup.mjs provisions both from personality/.
# The operator persona thinks about the operation; the copywriter owns the
# timeline. The X jobs speak through the copywriter, never the operator.
OBS_AGENT_ID=obs
OBS_X_AGENT_ID=obs-copywriter

# =============================================================================
# The X account (@ObscuraCEX): the autopilot's hands
# =============================================================================
# OAuth 1.0a user-context credentials. X_LIVE must be exactly "true" for
# anything to post; anything else is a dry run that logs to the ledger.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_LIVE=false
X_HANDLE=ObscuraCEX
# 280 unless the account is Premium.
X_MAX_TWEET_CHARS=280
# Cadence floor between posts, checked before any model call.
OBS_MIN_POST_GAP_MIN=90
# Never reply more than this many times in one engage pass.
OBS_ENGAGE_CAP=3
# Word-overlap ceiling against recent posts (0..1).
OBS_SIMILARITY_MAX=0.45

# =============================================================================
# The desk (public thoughts, the book, PnL)
# =============================================================================
# Minutes between desk cycles, checked before any model call.
OBS_MIN_THOUGHT_GAP_MIN=25
# Pairs the desk quotes each cycle, read-only: code/network->code/network:amount.
# Codes and networks are Obscura's (GET /currencies); Robinhood Chain is
# network "robinhood" with codes eth, usdg, nvda.
OBS_QUOTE_WATCHLIST="eth/robinhood->usdg/robinhood:0.05,usdg/robinhood->eth/robinhood:100"
# THE ARMING SWITCH. Off: a swap decision is a proposal on the board. On (and
# only with the wallet key present): a decision that passes every rail below
# is executed through Obscura from the desk's own wallet. Turn it on after the
# wallet is funded, the deposit is recorded, and you have read a few cycles.
OBS_TRADING=off
# Rails. Dollars per swap, dollars per trailing 24h, open orders at once, ETH
# kept back for gas on the from-chain, partners (blank = any Obscura quotes),
# and the SYMBOL@network pairs the desk may hold and move.
OBS_MAX_SWAP_USD=25
OBS_DAILY_SWAP_USD=100
OBS_MAX_OPEN_ORDERS=1
OBS_GAS_RESERVE_ETH=0.002
OBS_ALLOWED_PARTNERS=
OBS_TRADE_ASSETS=ETH@robinhood,USDG@robinhood
# Chains both legs of a swap must be on. The mandate is Robinhood Chain only.
OBS_TRADE_CHAINS=robinhood
# Where a decided swap runs once armed: the USDG pools on Robinhood Chain from
# the desk's own wallet (pool, the default), or Obscura's routes (obscura).
OBS_VENUE=pool
# The pool lane's slippage allowance below its own estimate, in percent.
OBS_SLIPPAGE_PCT=1

# ---- Launch candidates: the tokens a launch watcher finds, traded in the pool lane. ----
# The watcher's feed, a JSONL the operator runs elsewhere: rows of kind
# "candidate" (pool id, token, symbol, fee tier, gate verdict, hour, volume,
# move, senders) and "hourly" (per-pool volume and price). Empty = off.
OBS_CANDIDATE_FEED=
OBS_CANDIDATES=on
# A candidate must be this recent, at a tier at most this high, and gated by the watcher.
OBS_CANDIDATE_MAX_AGE_H=6
OBS_CANDIDATE_MAX_TIER_PCT=5
OBS_CANDIDATE_REQUIRE_GATE=on
# Early launches: shown from minute one for this long; a probe is allowed only once the watcher called ignition and a hookless side pool exists.
OBS_EARLY_MAX_AGE_MIN=90
OBS_EARLY_REQUIRE_IGNITION=on
# A launch curve's hook charges its own fee the pool key does not show; this is what the desk assumes for its estimate, plus the creator tax. Curves get a wider slippage floor.
OBS_CURVE_FEE_PCT=2
OBS_CURVE_SLIPPAGE_PCT=8
# The probe rule: the first buy of any launch token is capped here until its sell is proven.
OBS_PROBE_USD=5
# Launch positions held at once, and the exits the rails enforce on their own.
OBS_MAX_CANDIDATES=1
OBS_CANDIDATE_MAX_HOLD_H=8
OBS_CANDIDATE_FLOOR_PCT=40
OBS_CANDIDATE_VOLUME_DROP_PCT=30
# The trader's exits on a launch token: take this share off once up this much, and once up at least the arm level,
# sell everything when the price gives back this much from its peak since entry.
OBS_CANDIDATE_TAKE_PROFIT_PCT=60
OBS_CANDIDATE_TAKE_PROFIT_SHARE=0.5
OBS_CANDIDATE_TRAIL_ARM_PCT=30
OBS_CANDIDATE_TRAIL_PCT=25
# The fast tick's own floor between model calls, in minutes (the tick timer runs every 5).
OBS_TICK_MIN_GAP_MIN=4
# The whole-book brake: past either drawdown limit from the day's opening mark, no new entries until the next UTC day. Exits still run.
OBS_DAILY_LOSS_USD=50
OBS_DAILY_LOSS_PCT=5
# Selectivity. Entries (not exits) are spaced and counted, and a swap must be argued for:
# a thesis, this many EVIDENCE lines each quoting an observed figure, an invalidation, and this conviction (1 to 5).
OBS_MIN_HOURS_BETWEEN_ENTRIES=2
OBS_MAX_ENTRIES_PER_DAY=3
OBS_MIN_EVIDENCE=3
OBS_MIN_CONVICTION=4
# The basis on the tokenized stock is a side trade, off by default. OBS_BASIS=on adds NVDA@robinhood to the
# allowlist, reads the outside references, and puts the basis in the observation and on the page.
OBS_BASIS=off
OBS_BASIS_MIN_EDGE_PCT=0.25
# The bar for launch tokens, and the size each grade may reach. The first buy is always the probe (grade C size);
# a proven token can then be scaled to its grade cap, as a continuation. Below the bar is not tradable.
OBS_GRADE_A_MIN_VOL_USD=250000
OBS_GRADE_A_MIN_SENDERS=40
OBS_GRADE_A_MAX_MOVE_PCT=30
OBS_GRADE_A_MAX_TIER_PCT=3
OBS_GRADE_A_MIN_DEPTH_USD=20000
OBS_GRADE_A_MAX_DRAWDOWN_PCT=25
OBS_GRADE_A_MAX_HOUR=3
OBS_GRADE_B_MIN_VOL_USD=100000
OBS_GRADE_B_MIN_SENDERS=20
OBS_GRADE_B_MAX_MOVE_PCT=50
OBS_GRADE_B_MAX_TIER_PCT=4
OBS_GRADE_B_MAX_DRAWDOWN_PCT=40
OBS_CANDIDATE_MAX_USD_A=75
OBS_CANDIDATE_MAX_USD_B=25
OBS_CANDIDATE_MAX_USD_C=5
# Base RPC, only used if ETH@base is ever allowlisted (public default).
BASE_RPC_URL=https://mainnet.base.org

# =============================================================================
# Chain reads (public, read-only; OBS holds no key)
# =============================================================================
# The public RPC sits behind a bot challenge that blocks non-browser clients
# after a burst, and Blockscout's proxy rate-limits. Reads degrade to "not
# read" when that happens; the desk never counts an unread balance as zero.
# BEFORE ARMING set this to a provider endpoint (Alchemy serves Robinhood
# Chain), or every Robinhood-leg send will be refused by the pre-flight rail.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The one 40-hex address a post may contain: the $OBS token on Robinhood Chain.
# Anything else is blocked by the guards.
OBS_CONTRACT=0xfe242d1da8fd04f6a1f80b6d3d807b02e062ad4e
OBSCURA_SITE_URL=https://obscura.market
OBSCURA_API_URL=https://api.obscura.market

# =============================================================================
# The wallet (OBS's own; scripts/wallet.mjs create)
# =============================================================================
# The PUBLIC address only. The key lives in OBS_WALLET_DIR (default
# ~/.obs/wallet, owner-only permissions), never in this file, never in the
# repo, and nothing in the loops loads it until the execution stage exists.
OBS_WALLET_ADDRESS=
OBS_WALLET_DIR=
# Ethereum mainnet RPC for the wallet's mainnet balance (public default).
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# =============================================================================
# State and memory
# =============================================================================
# Where journals, ledgers and cursors are written. Default: ./data
OBS_DATA_DIR=
# The PRIVATE git checkout OBS snapshots his memory into (see OBS-MEMORY.md).
# Blank or missing = the backup step is skipped quietly.
# A clone of the private obscura-memory repo; the desk timer commits journals and ledgers there daily.
OBS_MEMORY_REPO_DIR=
# DRY_RUN=1 rehearses a job and writes nothing.
DRY_RUN=

# =============================================================================
# Dashboard API (read-only JSON for the Obscura dashboard integration)
# =============================================================================
OBS_DASHBOARD_PORT=4671
# Comma-separated origins allowed to read the API in a browser. * = any.
OBS_DASHBOARD_ORIGINS=*
# An entry may carry one wildcard host label, for preview deployments: https://*.vercel.app
# Manners for public exposure: requests a minute per client, open streams in total and per client.
OBS_DASHBOARD_RATE_PER_MIN=120
OBS_DASHBOARD_MAX_STREAMS=100
OBS_DASHBOARD_MAX_STREAMS_PER_IP=4
# The public bridge (scripts/_obs-tunnel.sh). A named Cloudflare tunnel token from the site's own zone
# gives a stable hostname such as obs-api.obscura.market; empty = a quick tunnel with a random hostname.
OBS_TUNNEL_TOKEN=

# ---- Hosted runner (docker compose; see DEPLOY.md). Ignored on the Mac. ----
# The desk cadence in seconds; the cycle's own 25-minute floor still applies.
OBS_DESK_INTERVAL_SEC=1800
# The X voice in the same process: on | off. Draft-first until X_LIVE=true.
OBS_VOICE=off
OBS_POST_INTERVAL_SEC=7200
OBS_ENGAGE_INTERVAL_SEC=600
# The private memory repo, as an HTTPS URL that can push (a fine-grained
# token scoped to that one repo). Cloned on first boot; the ledgers are
# restored from it when the data volume is empty; pushed to after cycles.
OBS_MEMORY_REPO_URL=
# The identity the backup commits as inside the container.
OBS_GIT_NAME=obs
OBS_GIT_EMAIL=obs@users.noreply.github.com

# ---- Paper sessions: the desk at full size with nothing sent. ----
# OBS_PAPER=on runs every step but the send and records paper trades in
# obs-paper.jsonl; `npm run paper` runs one cycle that way, `npm run
# paper:report` marks the paper book against the real one, `npm run
# paper:reset` clears it. Ignored while execution is armed.
OBS_PAPER=off

# The server (DEPLOY.md, "The server, as plain services"). OBS_SERVER is the
# ssh target the launch feed mirrors to every minute; OBS_PUBLIC_HOSTNAME is
# the API's public name there. Both are written by scripts/server/sync-to-server.sh.
OBS_SERVER=
OBS_PUBLIC_HOSTNAME=

# =============================================================================
# The entry read: volume puts a token on watch, price action gives the entry
# (agent/src/desk/entry.ts). Defaults shown; leave blank to keep them.
# =============================================================================
# Minutes of tape the read looks at, and the volume pickup (last 10 min against the earlier tape).
OBS_ENTRY_WINDOW_MIN=30
OBS_ENTRY_PICKUP_RATIO=2
OBS_ENTRY_MIN_SWAPS=6
# A run of at least this, within this much of its peak, is a spike: never bought.
OBS_ENTRY_SPIKE_RUN_PCT=15
OBS_ENTRY_SPIKE_NEAR_PEAK_PCT=3
# A pullback this far off the peak (and no further) that turned up by this much is an entry.
OBS_ENTRY_PULLBACK_MIN_PCT=8
OBS_ENTRY_PULLBACK_MAX_PCT=35
OBS_ENTRY_BOUNCE_MIN_PCT=2
# A range this tight over this many minutes, with an older peak, is a base.
OBS_ENTRY_BASE_RANGE_PCT=6
OBS_ENTRY_BASE_MIN=10
# Buy pressure over the last 10 minutes needed for any entry.
OBS_ENTRY_MIN_BUY_PRESSURE_PCT=50

# =============================================================================
# The stability hunt: tokens that have already shown it (agent/src/desk/stability.ts)
# =============================================================================
# on|off. Stable tokens lead the candidates at grade B for a swing.
OBS_STABLE=on
OBS_STABLE_MIN_ACTIVE_HOURS=6
OBS_STABLE_MIN_HOUR_USD=1000
OBS_STABLE_MAX_DRAWDOWN_PCT=50
OBS_STABLE_PEAK_HOURS=12
OBS_STABLE_MAX_RANGE_PCT=40
OBS_STABLE_MIN_RECENT_RATIO=0.5
OBS_STABLE_MIN_SENDERS=20
OBS_STABLE_MAX_AGE_H=2
# Megabytes of the feed's tail read each cycle; 24 gives trails a day long.
OBS_FEED_TAIL_MB=24

# =============================================================================
# The live watch: the desk in real time (agent/src/desk/live.ts, desk/watch.ts)
# =============================================================================
# Milliseconds between looks; balances refresh every this many ms.
OBS_LIVE_POLL_MS=3000
OBS_LIVE_BALANCES_MS=60000
OBS_LIVE_MAX_WATCH=8
# A held token is reviewed this often; an entry fires once, then again this often while it lasts;
# the least minutes between two cycles for one token; the tape give-back that fires an exit.
OBS_LIVE_HELD_EVERY_MIN=5
OBS_LIVE_ENTRY_EVERY_MIN=15
OBS_LIVE_COOLDOWN_MIN=3
OBS_LIVE_GIVEBACK_PCT=25

# =============================================================================
# The base, and fills
# =============================================================================
# eth (default): every sell comes back to ETH and parking in USDG is refused unless the basis is on.
OBS_BASE=eth
# A pool swap must receive at least this share of its quote, else the desk treats it as failed.
OBS_MIN_FILL_RATIO=0.97

# =============================================================================
# The launch feed between machines (DEPLOY.md). The machine that runs the
# watcher serves the file's bytes at /api/obs/feed-tail behind OBS_FEED_TOKEN;
# a hosted desk pulls them with the same token from OBS_FEED_SOURCE (the
# operator API's public base URL) into its own OBS_CANDIDATE_FEED.
# =============================================================================
OBS_FEED_TOKEN=
OBS_FEED_SOURCE=
OBS_FEED_PULL_SEC=30
OBS_FEED_PULL_TAIL_MB=24
# A hosted desk with no mount: the key file's JSON, handed in as a variable, written once at boot.
OBS_WALLET_JSON=

