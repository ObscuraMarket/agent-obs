<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.obscura.obsx</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AGENT_DIR__/scripts/_obs-post.sh</string>
  </array>
  <!-- 2h. The cadence floor in src/autopilot.ts (OBS_MIN_POST_GAP_MIN, default
       90m) is the real guard: checked BEFORE the model call. -->
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/obs-autopilot.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/obs-autopilot.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
