<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.obscura.obstick</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AGENT_DIR__/scripts/_obs-tick.sh</string>
  </array>
  <!-- Every 5 minutes. Cheap unless a token is in play; see scripts/_obs-tick.sh. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/obs-tick.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/obs-tick.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
