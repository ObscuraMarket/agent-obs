<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.obscura.obssite</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__AGENT_DIR__/../scripts/deploy-site.sh</string>
  </array>
  <!-- Every 10 minutes: the fork's main to obscura.markets, only when it moved. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/obs-site.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/obs-site.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
