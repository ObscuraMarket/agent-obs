<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.obscura.obsfeedsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AGENT_DIR__/scripts/_obs-feedsync.sh</string>
  </array>
  <!-- Every minute: the launch feed's new tail to the server. Quiet when OBS_SERVER is unset. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/obs-feedsync.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/obs-feedsync.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
